.DS_Store
.gitignore
public

.local/

# Independent publisher: generated output is never a second content source.
.generated/
.build/
__pycache__/
*.py[cod]

# Hugo migration repository: fail-closed root allowlist. Private local recovery
# archives and generated real content must never be accidentally added.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/.github/
/.github/*
!/.github/README.md
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/hugo-ci.yml
!/.github/workflows/hugo-pages.yml
!/pipeline/
# Local operating notes contain machine/Vault paths; use public CI docs instead.
/pipeline/README.md
!/tests/
!/publication/
/publication/*
!/publication/README.md
!/publication/fixture/
!/publication/current/
!/docs/
/docs/*
!/docs/hugo-ci.md
!/docs/hugo-publication.md
!/docs/hugo-stack.md
!/site/
!/preview.ps1
