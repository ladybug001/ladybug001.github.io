{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:obsidian-publisher:note:1",
  "title": "Framework-independent publication metadata, version 1",
  "type": "object",
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "publish": {"type": "boolean", "default": false},
    "draft": {"type": "boolean", "default": false},
    "private": {"type": "boolean", "default": false},
    "id": {"type": "string", "format": "uuid"},
    "slug": {"type": "string", "minLength": 1},
    "date": {"type": "string"},
    "updated": {"type": "string"},
    "tags": {"$ref": "#/$defs/stringList"},
    "categories": {"$ref": "#/$defs/stringList"},
    "series": {"$ref": "#/$defs/stringList"},
    "aliases": {"$ref": "#/$defs/stringList"}
  },
  "$defs": {
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true,
  "$comment": "Runtime frontmatter.py also rejects blank strings, invalid single-segment slugs, invalid dates, naive datetimes, duplicate YAML keys and YAML aliases. Source aliases are note names, never Hugo redirects. Missing id/date is allowed for read-only inspection, not an invented value."
}
